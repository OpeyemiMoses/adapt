# ADAPT Memory Configuration
ADAPT_STORAGE_DIR=~/.hermes/adapt
ADAPT_DB_NAME=adapt_memory.db

# Retrieval Settings
ADAPT_DEFAULT_TOP_K=5
ADAPT_HYBRID_ALPHA=0.5
ADAPT_MIN_RELEVANCE_SCORE=0.30

# Embedding Settings (Optional: defaults to local lexical FTS5 fallback if unset)
ADAPT_EMBEDDING_PROVIDER=none
# Optional API Keys if remote provider configured:
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Consolidation & Retention
ADAPT_AUTO_CONSOLIDATE=true
ADAPT_WORKING_MEMORY_TTL_HOURS=24
ADAPT_LOG_LEVEL=INFO
